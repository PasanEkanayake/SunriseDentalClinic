<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sunrise Dental Clinic</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="<%=request.getContextPath()%>/css/style.css" rel="stylesheet">
    
    <style>
        :root {
            --app-nav-bg: linear-gradient(135deg, #0a2540 0%, #0f172a 100%);
            --app-accent-blue: #0284c7;
        }

        .app-navbar {
            background: var(--app-nav-bg);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            padding: 0.75rem 1rem;
        }

        .app-navbar .navbar-brand span {
            letter-spacing: -0.3px;
            font-size: 1.15rem;
        }

        .app-navbar .nav-link {
            color: rgba(255, 255, 255, 0.75) !important;
            font-weight: 500;
            font-size: 0.825rem;
            padding: 0.5rem 0.85rem !important;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .app-navbar .nav-link:hover,
        .app-navbar .nav-link.active {
            color: #ffffff !important;
            background: rgba(255, 255, 255, 0.1);
        }

        .app-navbar .dropdown-menu {
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 0.5rem;
            margin-top: 0.5rem;
        }

        .app-navbar .dropdown-item {
            border-radius: 6px;
            padding: 0.5rem 0.85rem;
            font-size: 0.9rem;
            font-weight: 500;
            color: #334155;
            transition: all 0.15s ease;
        }

        .app-navbar .dropdown-item:hover {
            background-color: #f1f5f9;
            color: #0284c7;
        }

        .avatar-circle {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #0ea5e9 0%, #2563eb 100%);
            color: #ffffff;
            font-weight: 700;
            font-size: 0.95rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            box-shadow: 0 2px 8px rgba(14, 165, 233, 0.3);
            border: 2px solid rgba(255, 255, 255, 0.2);
        }

        .profile-pill {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.12);
            padding: 0.25rem 0.75rem 0.25rem 0.35rem;
            border-radius: 50px;
            transition: background 0.2s ease;
        }

        .profile-pill:hover {
            background: rgba(255, 255, 255, 0.15);
        }

        .custom-alert {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
            padding: 1rem 1.25rem;
        }

        .custom-alert-success {
            background-color: #ecfdf5;
            color: #065f46;
            border-left: 4px solid #10b981;
        }

        .custom-alert-danger {
            background-color: #fef2f2;
            color: #991b1b;
            border-left: 4px solid #ef4444;
        }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark app-navbar sticky-top">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="<%=request.getContextPath()%>/DashboardServlet">
            <img src="<%=request.getContextPath()%>/images/logo.svg" alt="Sunrise Dental Clinic logo" width="32" height="32">
            <span>Sunrise Dental Clinic</span>
        </a>
        
        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navMain">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1" id="mainNavLinks">
                <li class="nav-item">
                    <a class="nav-link" data-path="/DashboardServlet" href="<%=request.getContextPath()%>/DashboardServlet">
                        <i class="bi bi-speedometer2 me-1"></i> Dashboard
                    </a>
                </li>

                <li class="nav-item dropdown hover-dropdown">
                    <a class="nav-link dropdown-toggle" data-path="/RegisterAppointmentServlet" href="<%=request.getContextPath()%>/RegisterAppointmentServlet"
                       role="button" data-bs-toggle="dropdown">
                        <i class="bi bi-calendar-plus me-1"></i> New Appointment
                    </a>
                    <ul class="dropdown-menu shadow-sm">
                        <li><a class="dropdown-item" href="<%=request.getContextPath()%>/RegisterAppointmentServlet"><i class="bi bi-plus-circle me-2 text-primary"></i>Register Appointment</a></li>
                        <li><a class="dropdown-item" href="<%=request.getContextPath()%>/AppointmentListServlet?status=SCHEDULED"><i class="bi bi-calendar-week me-2 text-info"></i>View Scheduled</a></li>
                    </ul>
                </li>

                <li class="nav-item">
                    <a class="nav-link" data-path="/SearchAppointmentServlet" href="<%=request.getContextPath()%>/SearchAppointmentServlet">
                        <i class="bi bi-search me-1"></i> Search
                    </a>
                </li>

                <li class="nav-item dropdown hover-dropdown">
                    <a class="nav-link dropdown-toggle" data-path="/AppointmentListServlet" href="<%=request.getContextPath()%>/AppointmentListServlet"
                       role="button" data-bs-toggle="dropdown">
                        <i class="bi bi-list-check me-1"></i> All Appointments
                    </a>
                    <ul class="dropdown-menu shadow-sm">
                        <li><a class="dropdown-item" href="<%=request.getContextPath()%>/AppointmentListServlet"><i class="bi bi-collection me-2"></i>All Appointments</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="<%=request.getContextPath()%>/AppointmentListServlet?status=SCHEDULED"><i class="bi bi-clock me-2 text-primary"></i>Scheduled</a></li>
                        <li><a class="dropdown-item" href="<%=request.getContextPath()%>/AppointmentListServlet?status=COMPLETED"><i class="bi bi-check2-circle me-2 text-success"></i>Completed</a></li>
                        <li><a class="dropdown-item" href="<%=request.getContextPath()%>/AppointmentListServlet?status=CANCELLED"><i class="bi bi-x-circle me-2 text-danger"></i>Cancelled</a></li>
                    </ul>
                </li>

                <li class="nav-item">
                    <a class="nav-link" data-path="/help.jsp" href="<%=request.getContextPath()%>/help.jsp">
                        <i class="bi bi-question-circle me-1"></i> Help
                    </a>
                </li>

                <c:if test="${sessionScope.staffRole == 'ADMIN'}">
                    <li class="nav-item dropdown hover-dropdown">
                        <a class="nav-link dropdown-toggle" data-path="/AdminPanelServlet" href="<%=request.getContextPath()%>/AdminPanelServlet"
                           role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-shield-lock me-1"></i> Admin
                        </a>
                        <ul class="dropdown-menu shadow-sm">
                            <li><a class="dropdown-item" href="<%=request.getContextPath()%>/AdminPanelServlet"><i class="bi bi-grid-1x2 me-2 text-danger"></i>Admin Panel</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="<%=request.getContextPath()%>/ManageStaffServlet"><i class="bi bi-people me-2"></i>Manage Staff</a></li>
                            <li><a class="dropdown-item" href="<%=request.getContextPath()%>/ManageDentistServlet"><i class="bi bi-person-badge me-2"></i>Manage Dentists</a></li>
                            <li><a class="dropdown-item" href="<%=request.getContextPath()%>/ManageTreatmentServlet"><i class="bi bi-clipboard2-pulse me-2"></i>Manage Treatments</a></li>
                            <li><a class="dropdown-item" href="<%=request.getContextPath()%>/ManageSettingsServlet"><i class="bi bi-gear me-2"></i>Clinic Settings</a></li>
                            <li><a class="dropdown-item" href="<%=request.getContextPath()%>/ManageInquiriesServlet"><i class="bi bi-envelope-paper me-2"></i>Website Inquiries</a></li>
                        </ul>
                    </li>
                </c:if>

                <li class="nav-item ms-lg-2">
                    <a class="nav-link text-white-50" href="<%=request.getContextPath()%>/PublicHomeServlet" target="_blank" rel="noopener">
                        <i class="bi bi-globe me-1"></i> View Website
                    </a>
                </li>
            </ul>

            <div class="dropdown hover-dropdown profile-dropdown mt-2 mt-lg-0">
                <a class="d-flex align-items-center text-decoration-none profile-pill dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                    <span class="avatar-circle me-2">
					    <c:out value="${fn:substring(sessionScope.staffName, 0, 1)}"/>
					</span>
                    <span class="text-light me-2 small fw-semibold">
                        <c:out value="${sessionScope.staffName}"/>
                        <span class="badge bg-white bg-opacity-20 text-black border border-white border-opacity-25 ms-1"><c:out value="${sessionScope.staffRole}"/></span>
                    </span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                    <li><h6 class="dropdown-header">Signed in as <strong class="text-dark"><c:out value="${sessionScope.staffName}"/></strong></h6></li>
                    <li><a class="dropdown-item" href="<%=request.getContextPath()%>/DashboardServlet"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                    <c:if test="${sessionScope.staffRole == 'ADMIN'}">
                        <li><a class="dropdown-item" href="<%=request.getContextPath()%>/AdminPanelServlet"><i class="bi bi-shield-lock me-2 text-danger"></i>Admin Panel</a></li>
                    </c:if>
                    <li><a class="dropdown-item" href="<%=request.getContextPath()%>/help.jsp"><i class="bi bi-question-circle me-2"></i>Help</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger fw-semibold" href="<%=request.getContextPath()%>/LogoutServlet"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                </ul>
            </div>
        </div>
    </div>
</nav>

<div class="container my-4">

    <c:if test="${not empty successMessage}">
        <div class="alert custom-alert custom-alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div><c:out value="${successMessage}"/></div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    </c:if>
    <c:if test="${not empty errorMessage}">
        <div class="alert custom-alert custom-alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div><c:out value="${errorMessage}"/></div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    </c:if>
    <c:if test="${not empty sessionScope.flashSuccess}">
        <div class="alert custom-alert custom-alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div><c:out value="${sessionScope.flashSuccess}"/></div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
        <% session.removeAttribute("flashSuccess"); %>
    </c:if>
    <c:if test="${not empty sessionScope.flashError}">
        <div class="alert custom-alert custom-alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div><c:out value="${sessionScope.flashError}"/></div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
        <% session.removeAttribute("flashError"); %>
    </c:if>